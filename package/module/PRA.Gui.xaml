<!-- Native WPF Fluent resources (.NET 9+, PowerShell 7.5+). Guided operator console: Setup, Task, Verify, Run, Next steps. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRA Remote Mailbox" Width="1480" Height="940" MinWidth="1180" MinHeight="680" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <!-- Text and card styles. The native Fluent templates of Button, TextBox, CheckBox, Expander, ProgressBar and ScrollViewer are not replaced. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,14,18,16"/><Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/></Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,2"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NoEmpty" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>

    <!-- Buttons: the native Fluent templates; only the link style and the accent button are local. -->
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PraBrandText}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" Padding="4,2" CornerRadius="4"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource PraAccentSoft}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented choice (few options: clearer than a drop-down), task tile, navigation chip. -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="6" BorderThickness="1" Padding="12,5" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PraBrandText}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource PraAccentSoft}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PraBrand}"/>
                <Setter Property="Foreground" Value="{DynamicResource PraBrandText}"/><Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="B" CornerRadius="10" BorderThickness="1.5" Padding="16,14,16,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"><ContentPresenter/></Border>
              <Border x:Name="Tick" Visibility="Collapsed" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PraBrand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;" FontSize="13" Foreground="{DynamicResource PraOnBrand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PraBrandText}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PraBrand}"/>
                <Setter TargetName="B" Property="Background" Value="{DynamicResource PraAccentSoft}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavChip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="16" Padding="6,5,14,5" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PraTrack}"><TextBlock Text="{TemplateBinding Tag}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="Num"/></Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource PraBrand}"/>
                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource PraOnBrand}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="B" Property="Background" Value="{DynamicResource PraAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Read-only monospace box and thin progress bar, both based on the native Fluent styles. -->
    <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Bar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Setter Property="Height" Value="5"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource PraBrand}"/><Setter Property="Background" Value="{DynamicResource PraTrack}"/>
    </Style>

    <!-- Lists -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource PraAccentSoft}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PraBrand}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BatchItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
      <Setter Property="IsEnabled" Value="{Binding Selectable}"/>
    </Style>
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}"/>
    </Style>

    <!-- Status glyph: pending, running (spins), ok, warning, failed, waiting, skipped, info. The rows are notifying objects: the glyph follows Status. -->
    <DataTemplate x:Key="GlyphT">
      <TextBlock x:Name="G" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xEA3A;" Foreground="{DynamicResource TextFillColorTertiaryBrush}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
        <TextBlock.RenderTransform><RotateTransform x:Name="Rot" Angle="0"/></TextBlock.RenderTransform>
      </TextBlock>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Running">
          <Setter TargetName="G" Property="Text" Value="&#xE895;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource PraBrandText}"/>
          <DataTrigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetName="Rot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.6" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Spin"/></DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Ok"><Setter TargetName="G" Property="Text" Value="&#xE73E;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource PraSuccess}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warn"><Setter TargetName="G" Property="Text" Value="&#xE7BA;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource PraCaution}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter TargetName="G" Property="Text" Value="&#xEA39;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource PraCritical}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Wait"><Setter TargetName="G" Property="Text" Value="&#xE823;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource PraCaution}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Skip"><Setter TargetName="G" Property="Text" Value="&#xE72A;"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="NA"><Setter TargetName="G" Property="Text" Value="&#xE738;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Info"><Setter TargetName="G" Property="Text" Value="&#xE946;"/><Setter TargetName="G" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Step of the run -->
    <DataTemplate x:Key="StepT">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}" VerticalAlignment="Top" Margin="0,1,0,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="T" Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="{Binding Counter, Mode=OneWay}" Style="{StaticResource NoEmpty}" Margin="0,2,0,0"/>
          <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Note, Mode=OneWay}" Style="{StaticResource NoEmpty}" Foreground="{DynamicResource PraBrandText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Elapsed, Mode=OneWay}" FontSize="12" Margin="10,2,4,0" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Pending"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter TargetName="Bar" Property="Opacity" Value="0.35"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Skip"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/><Setter TargetName="Bar" Property="Opacity" Value="0.25"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Ok"><Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource PraSuccess}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warn"><Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource PraCaution}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource PraCritical}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Object (or sub-check) of a step -->
    <DataTemplate x:Key="ObjT">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Upn, Mode=OneWay}" Style="{StaticResource NoEmpty}" FontSize="11"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Result, Mode=OneWay}" FontSize="12" Margin="10,0,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding Result}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>
    </DataTemplate>

    <!-- Object in the preview grid -->
    <DataTemplate x:Key="VerT">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="170"/><ColumnDefinition Width="230"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock Grid.Column="2" Text="{Binding Upn, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock Grid.Column="3" Text="{Binding Type, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock Grid.Column="4" Text="{Binding Result, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Plain}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
      </Grid>
    </DataTemplate>

    <!-- Detected batch or transfer package -->
    <DataTemplate x:Key="BatchT">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource PraInfoBg}" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph, Mode=OneWay}" FontSize="16" Foreground="{DynamicResource PraBrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="{Binding Sub, Mode=OneWay}" Style="{StaticResource Hint}"/>
        </StackPanel>
        <Border x:Name="Pl" Grid.Column="2" Style="{StaticResource Pill}" Background="{DynamicResource PraInfoBg}">
          <TextBlock x:Name="PlT" Text="{Binding State, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter TargetName="Pl" Property="Background" Value="{DynamicResource PraSuccessBg}"/><Setter TargetName="PlT" Property="Foreground" Value="{DynamicResource PraSuccess}"/></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter TargetName="Pl" Property="Background" Value="{DynamicResource PraCautionBg}"/><Setter TargetName="PlT" Property="Foreground" Value="{DynamicResource PraCaution}"/></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter TargetName="Pl" Property="Background" Value="{DynamicResource PraCriticalBg}"/><Setter TargetName="PlT" Property="Foreground" Value="{DynamicResource PraCritical}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Prerequisite light -->
    <DataTemplate x:Key="LightT">
      <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="12,10" Margin="0,0,10,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}"/>
            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          </StackPanel>
          <TextBlock x:Name="Dt" Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource Hint}" Margin="24,4,0,0"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource PraCriticalBg}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PraCritical}"/><Setter TargetName="Dt" Property="Foreground" Value="{DynamicResource PraCritical}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Journey of an object, message list, timeline -->
    <DataTemplate x:Key="JourneyT">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="{Binding Caption, Mode=OneWay}" Style="{StaticResource Hint}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MsgT">
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}" VerticalAlignment="Top"/>
        <TextBlock Grid.Column="1" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TimelineT">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid>
          <Border x:Name="Line" Width="2" Background="{DynamicResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" Margin="0,30,0,-6"/>
          <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PraInfoBg}" VerticalAlignment="Top" HorizontalAlignment="Center"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource GlyphT}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
        <StackPanel Grid.Column="1" Margin="4,3,0,22">
          <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="{Binding Caption, Mode=OneWay}" Style="{StaticResource Hint}"/>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Last}" Value="True"><Setter TargetName="Line" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="24,16,24,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource PraBrand}" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="22" Foreground="{DynamicResource PraOnBrand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="EXCHANGE DISASTER RECOVERY &#xB7; HYBRID &#xB7; AD &#x2192; CLOUD &#x2192; FINALIZE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PraBrandText}"/>
        <TextBlock Text="PRA Remote Mailbox" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock x:Name="HeaderSub" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Move mailboxes to the cloud, roll them back, and finish the restore. The console tells you what to do next."/>
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <RadioButton x:Name="Th_System" GroupName="Theme" Style="{StaticResource Seg}" Content="System" FontSize="12" Margin="0,0,4,0"/>
          <RadioButton x:Name="Th_Light" GroupName="Theme" Style="{StaticResource Seg}" Content="Light" FontSize="12" Margin="0,0,4,0"/>
          <RadioButton x:Name="Th_Dark" GroupName="Theme" Style="{StaticResource Seg}" Content="Dark" FontSize="12" Margin="0,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Grid>

    <!-- Navigation -->
    <Border Grid.Row="1" Margin="24,4,24,10" Padding="8,6" CornerRadius="22" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="Nav1" GroupName="Nav" Style="{StaticResource NavChip}" Tag="1" Content="Setup"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
          <RadioButton x:Name="Nav2" GroupName="Nav" Style="{StaticResource NavChip}" Tag="2" Content="Task"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
          <RadioButton x:Name="Nav3" GroupName="Nav" Style="{StaticResource NavChip}" Tag="3" Content="Verify"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
          <RadioButton x:Name="Nav4" GroupName="Nav" Style="{StaticResource NavChip}" Tag="4" Content="Run"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
          <RadioButton x:Name="Nav5" GroupName="Nav" Style="{StaticResource NavChip}" Tag="5" Content="Next steps"/>
        </StackPanel>
        <TextBlock x:Name="ContextText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>
    </Border>

    <!-- Pages -->
    <Grid Grid.Row="2">

      <!-- PAGE 1: Setup (three lines to read when the lights are green; the run settings open on demand) -->
      <ScrollViewer x:Name="Page1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,8">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
