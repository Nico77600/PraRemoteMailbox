    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PraAccentSoft}" VerticalAlignment="Top"><TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="20" Foreground="{DynamicResource PraBrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Margin="12,0,26,0" VerticalAlignment="Center">
      <TextBlock Text="Complete a rollback" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
      <TextBlock Text="FINALIZE" Style="{StaticResource Label}" Margin="0,2,0,0"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Apply the last Active Directory changes of a rollback. Shown only when a package exists." Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"/>
  </Grid>
</RadioButton><RadioButton x:Name="T_Check" GroupName="Task" Style="{StaticResource Tile}" Margin="0,0,12,0">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PraAccentSoft}" VerticalAlignment="Top"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="20" Foreground="{DynamicResource PraBrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Margin="12,0,26,0" VerticalAlignment="Center">
      <TextBlock Text="Check a mailbox" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
      <TextBlock Text="CHECK" Style="{StaticResource Label}" Margin="0,2,0,0"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Look at one mailbox in AD and in the cloud and say if they agree. Changes nothing." Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"/>
  </Grid>
</RadioButton>
          </UniformGrid>
          <Border x:Name="OnWhat" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="OnWhatTitle" Text="On what?" Style="{StaticResource CardTitle}" FontSize="16"/>
              <TextBlock x:Name="OnWhatEmpty" Style="{StaticResource Hint}" FontSize="13" Text="Pick a task above."/>
              <StackPanel x:Name="ModeBox" Visibility="Collapsed" Margin="0,0,0,12">
                <WrapPanel>
                  <RadioButton x:Name="Mode_New" GroupName="Mode" Style="{StaticResource Seg}" Content="Start a new batch"/>
                  <RadioButton x:Name="Mode_Continue" GroupName="Mode" Style="{StaticResource Seg}" Content="Continue an existing batch"/>
                </WrapPanel>
              </StackPanel>
              <StackPanel x:Name="SourceBox" Visibility="Collapsed">
                <TextBlock Text="Objects to process" Style="{StaticResource RowLabel}" Margin="0,0,0,6"/>
                <WrapPanel>
                  <RadioButton x:Name="S_Source_Single" GroupName="G_Source" Style="{StaticResource Seg}" Content="Single identity (test)"/>
                  <RadioButton x:Name="S_Source_Scope" GroupName="G_Source" Style="{StaticResource Seg}" Content="Configured scope"/>
                  <RadioButton x:Name="S_Source_Ou" GroupName="G_Source" Style="{StaticResource Seg}" Content="OU"/>
                  <RadioButton x:Name="S_Source_Group" GroupName="G_Source" Style="{StaticResource Seg}" Content="AD group"/>
                  <RadioButton x:Name="S_Source_Csv" GroupName="G_Source" Style="{StaticResource Seg}" Content="CSV"/>
                </WrapPanel>
                <WrapPanel>
                <Grid x:Name="Row_Identity" Width="460" Margin="0,0,20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,5" MinHeight="22">
    <TextBlock Text="Identity" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
    <StackPanel x:Name="M_Identity" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
      <Border Style="{StaticResource Pill}" Background="{DynamicResource PraAccentSoft}" Padding="8,1"><TextBlock Text="modified" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PraBrandText}"/></Border>
      <Button x:Name="R_Identity" Style="{StaticResource LinkBtn}" Content="Reset" ToolTip="Back to the value of the configuration file" Margin="4,0,0,0"/>
    </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1"><DockPanel><Button x:Name="BtnCheckIdentity" DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0"/><TextBox x:Name="F_Identity"/></DockPanel></StackPanel>
  <TextBlock Grid.Row="2" Text="UPN, sam, DN or GUID of one account. The safest way to try a run." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
  <TextBlock x:Name="IdentityInfo" Grid.Row="3" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
</Grid>
                <Border x:Name="Row_ScopeInfo" Style="{StaticResource Pill}" Background="{DynamicResource PraInfoBg}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,12">
                  <TextBlock x:Name="ScopeInfoText" Style="{StaticResource Hint}" MaxWidth="900"/>
                </Border>
                <Grid x:Name="Row_Ou" Width="560" Margin="0,0,20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,5" MinHeight="22">
    <TextBlock Text="Organizational unit" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
    <StackPanel x:Name="M_Ou" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
      <Border Style="{StaticResource Pill}" Background="{DynamicResource PraAccentSoft}" Padding="8,1"><TextBlock Text="modified" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PraBrandText}"/></Border>
      <Button x:Name="R_Ou" Style="{StaticResource LinkBtn}" Content="Reset" ToolTip="Back to the value of the configuration file" Margin="4,0,0,0"/>
    </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1"><DockPanel><Button x:Name="BtnPickOu" DockPanel.Dock="Right" Content="Pick an OU..." Margin="8,0,0,0"/><TextBox x:Name="F_Ou"/></DockPanel></StackPanel>
  <TextBlock Grid.Row="2" Text="Distinguished name; sub-OUs are included." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
</Grid>
                <Grid x:Name="Row_Group" Width="560" Margin="0,0,20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,5" MinHeight="22">
    <TextBlock Text="AD group" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
  </Grid>
  <StackPanel Grid.Row="1"><DockPanel><Button x:Name="BtnCheckGroup" DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0"/><TextBox x:Name="F_Group"/></DockPanel></StackPanel>
  <TextBlock Grid.Row="2" Text="Name (sAMAccountName or CN) or distinguished name; members of nested groups are included." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
  <TextBlock x:Name="GroupInfo" Grid.Row="3" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
</Grid>
                <Grid x:Name="Row_Csv" Width="560" Margin="0,0,20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,5" MinHeight="22">
    <TextBlock Text="CSV file" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
    <StackPanel x:Name="M_Csv" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
      <Border Style="{StaticResource Pill}" Background="{DynamicResource PraAccentSoft}" Padding="8,1"><TextBlock Text="modified" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PraBrandText}"/></Border>
      <Button x:Name="R_Csv" Style="{StaticResource LinkBtn}" Content="Reset" ToolTip="Back to the value of the configuration file" Margin="4,0,0,0"/>
    </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1"><DockPanel><Button x:Name="BtnPickCsv" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/><TextBox x:Name="F_Csv"/></DockPanel></StackPanel>
  <TextBlock Grid.Row="2" Text="One column named Identity (UPN, sam, DN or GUID)." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
</Grid>
                </WrapPanel>
                <TextBlock x:Name="SourceInfo" Style="{StaticResource Hint}" FontSize="13"/>
              </StackPanel>
              <StackPanel x:Name="BatchBox" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="BatchHelp" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center"/>
                  <Button x:Name="BtnImport" Grid.Column="1" Content="Import package&#x2026;" Margin="12,0,0,0"/>
                </Grid>
                <ListBox x:Name="BatchList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BatchItem}" ItemTemplate="{StaticResource BatchT}" MaxHeight="270"/>
                <TextBlock x:Name="BatchEmpty" Style="{StaticResource NoEmpty}" FontSize="13" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel x:Name="CheckPanel" Visibility="Collapsed">
                <TextBlock Text="Mailbox to check" Style="{StaticResource RowLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="F_CheckUpn" MaxWidth="460" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="A UPN is enough: the check then skips the search in Active Directory."/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="PhaseCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="PhasePill" Style="{StaticResource Pill}" Padding="12,3" VerticalAlignment="Top" Margin="0,0,14,0"><TextBlock x:Name="PhasePillText" FontWeight="SemiBold" FontSize="13"/></Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="What will happen on this server" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                <TextBlock x:Name="PhaseText" Style="{StaticResource Hint}" FontSize="13"/>
                <StackPanel x:Name="BlockBox" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" Foreground="{DynamicResource PraCritical}" Margin="0,2,8,0"/>
                  <TextBlock x:Name="BlockText" Style="{StaticResource Hint}" Foreground="{DynamicResource PraCritical}" FontSize="13" MaxWidth="900"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="BtnFixHome" Grid.Column="2" Content="Fix on the Setup page" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <TextBlock x:Name="TaskError" Style="{StaticResource Hint}" Foreground="{DynamicResource PraCritical}" FontSize="13"/>
        </StackPanel>
      </ScrollViewer>

      <!-- PAGE 3: Verify -->
      <Grid x:Name="Page3" Margin="24,0,24,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SumIcon" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource PraInfoBg}" VerticalAlignment="Top" Margin="0,0,16,0">
              <TextBlock x:Name="SumGlyph" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="SumTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
              <TextBlock x:Name="SumText" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
              <TextBlock x:Name="ValidationText" Style="{StaticResource NoEmpty}" FontSize="13" Foreground="{DynamicResource PraCritical}" Margin="0,6,0,0"/>
              <StackPanel x:Name="Chips" Orientation="Horizontal" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12,14,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <TextBlock x:Name="GridTitle" Text="Objects" Style="{StaticResource CardTitle}" Margin="0"/>
              <WrapPanel HorizontalAlignment="Right" Margin="0,-4,0,-6">
                <RadioButton x:Name="Fl_All" GroupName="Fl" Style="{StaticResource Seg}" Content="All" FontSize="12" Margin="0,0,4,0"/>
                <RadioButton x:Name="Fl_User" GroupName="Fl" Style="{StaticResource Seg}" Content="Users" FontSize="12" Margin="0,0,4,0"/>
                <RadioButton x:Name="Fl_Shared" GroupName="Fl" Style="{StaticResource Seg}" Content="Shared" FontSize="12" Margin="0,0,4,0"/>
                <RadioButton x:Name="Fl_Warn" GroupName="Fl" Style="{StaticResource Seg}" Content="With warnings" FontSize="12" Margin="0,0,0,0"/>
              </WrapPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="10,0,10,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="170"/><ColumnDefinition Width="230"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource Label}"/><TextBlock Grid.Column="2" Text="ACCOUNT" Style="{StaticResource Label}"/>
              <TextBlock Grid.Column="3" Text="TYPE" Style="{StaticResource Label}"/><TextBlock Grid.Column="4" Text="WHAT WE FOUND" Style="{StaticResource Label}"/>
            </Grid>
            <ListBox x:Name="VerList" Grid.Row="2" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource VerT}" SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"/>
            <StackPanel x:Name="VerEmpty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
              <TextBlock x:Name="VerEmptyGlyph" Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              <TextBlock x:Name="VerEmptyText" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" MaxWidth="420" Text="Click Preview to see exactly what would change. The preview only reads: nothing is modified."/>
              <ProgressBar x:Name="VerBar" Style="{StaticResource Bar}" Width="260" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="ConfirmCard" Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Confirm" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
              <TextBlock x:Name="ConfirmText" Style="{StaticResource Hint}" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="ConfirmBox" Width="200" FontSize="15" IsEnabled="False" ToolTip="Type the word shown (capitals or not) to authorise the run after the preview."/>
              <TextBlock x:Name="ConfirmTick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="18" Foreground="{DynamicResource PraSuccess}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Hidden"/>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,2,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="What will happen, in order" Style="{StaticResource CardTitle}"/>
              <ItemsControl x:Name="PlanList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,9">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PraAccentSoft}" VerticalAlignment="Top" Margin="0,1,0,0"><TextBlock Text="{Binding N, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PraBrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <TextBlock Grid.Column="1" Text="{Binding Title, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding What}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Settings used" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="UsedText" Style="{StaticResource Hint}" FontSize="13"/>
              <Button x:Name="BtnEditSettings" Content="Change settings" HorizontalAlignment="Left" Style="{StaticResource LinkBtn}" Margin="-4,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel></ScrollViewer>
      </Grid>

      <!-- PAGE 4: Run -->
      <Grid x:Name="Page4" Margin="24,0,24,0" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,12,18,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="RunTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="RunSub" Style="{StaticResource Hint}" FontSize="13"/>
              </StackPanel>
              <Border x:Name="RunPill" Grid.Column="1" Style="{StaticResource Pill}" Padding="14,4"><TextBlock x:Name="RunPillText" FontSize="14" FontWeight="SemiBold"/></Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ProgressBar x:Name="RunBar" Style="{StaticResource Bar}" Height="8" VerticalAlignment="Center"/>
              <TextBlock x:Name="RunBarText" Grid.Column="1" Margin="14,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="470"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="12,12,8,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="StepsTitle" Text="Steps" Style="{StaticResource CardTitle}" Margin="6,0,0,6"/>
              <ListBox x:Name="StepList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource StepT}" SelectionMode="Single"/>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14,16,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Border x:Name="DetPill" Grid.Column="1" Style="{StaticResource Pill}" Margin="10,0,0,0"><TextBlock x:Name="DetPillText" FontSize="12" FontWeight="SemiBold"/></Border>
              </Grid>
              <StackPanel Grid.Row="1">
                <TextBlock x:Name="DetWhat" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,10"/>
                <Border x:Name="WaitBox" Visibility="Collapsed" CornerRadius="10" Padding="16,14" Margin="0,0,0,12" Background="{DynamicResource PraCautionBg}" BorderBrush="{DynamicResource PraCaution}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock x:Name="WaitTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="WaitLine" FontSize="16" Margin="0,6,0,0" Foreground="{DynamicResource PraCaution}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WaitNormal" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock x:Name="DetObjHeader" Grid.Row="2" Style="{StaticResource Label}" Margin="0,0,0,4"/>
              <ListBox x:Name="DetObjList" Grid.Row="3" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ObjT}" SelectionMode="Single"/>
              <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock Text="WARNINGS AND ERRORS" Style="{StaticResource Label}"/>
                <ItemsControl x:Name="DetMsgs" ItemTemplate="{StaticResource MsgT}"/>
                <TextBlock x:Name="DetNoMsg" Style="{StaticResource Hint}" FontSize="13" Text="Nothing to report so far."/>
                <Expander Header="Technical message" Margin="0,4,0,0">
                  <TextBox x:Name="DetRaw" Style="{StaticResource Mono}" MaxHeight="130" MinHeight="70" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                </Expander>
                <Expander x:Name="LogExpander" Header="Activity log" Margin="0,2,0,0">
                  <ListBox x:Name="ActivityLog" MaxHeight="150" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Expander>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14,16,12">
            <Grid>
              <StackPanel x:Name="ObjEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" FontSize="13" Margin="0,8,0,0" Text="Click a mailbox in the middle list to see its journey, its backup and its warnings."/>
              </StackPanel>
              <ScrollViewer x:Name="ObjCard" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="CardName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                  <TextBlock x:Name="CardUpn" Style="{StaticResource Hint}" FontSize="13"/>
                  <Border x:Name="CardTypePill" Style="{StaticResource Pill}" Background="{DynamicResource PraInfoBg}" HorizontalAlignment="Left" Margin="0,6,0,12"><TextBlock x:Name="CardType" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></Border>
                  <TextBlock Text="JOURNEY" Style="{StaticResource Label}"/>
                  <ItemsControl x:Name="Journey" ItemTemplate="{StaticResource JourneyT}"/>
                  <TextBlock Text="BACKUP" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                  <TextBox x:Name="CardBackup" Style="{StaticResource Mono}" FontSize="11"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button x:Name="BtnCardOpen" Content="Open folder" MinWidth="0" Padding="10,4" Margin="0,0,6,0"/>
                    <Button x:Name="BtnCardCopy" Content="Copy path" MinWidth="0" Padding="10,4"/>
                  </StackPanel>
                  <TextBlock Text="WARNINGS" Style="{StaticResource Label}"/>
                  <ItemsControl x:Name="CardMsgs" ItemTemplate="{StaticResource MsgT}"/>
                  <TextBlock x:Name="CardNoMsg" Style="{StaticResource Hint}" FontSize="13" Text="None."/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- PAGE 5: Next steps -->
      <ScrollViewer x:Name="Page5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <Grid Margin="24,0,24,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22,18,22,20">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><Border x:Name="NextPill" Style="{StaticResource Pill}" Padding="12,3"><TextBlock x:Name="NextPillText" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnReport" Content="Open report" Margin="0,0,8,0"/>
                    <Button x:Name="BtnLog" Content="Open log"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="NextTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="NextLead" FontSize="17" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Border x:Name="PackageBox" CornerRadius="8" Padding="14,12" Margin="0,16,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="26" Foreground="{DynamicResource PraBrandText}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="PkgName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                      <TextBlock x:Name="PkgPath" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                      <TextBlock x:Name="PkgInfo" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnOpenFolder" Style="{StaticResource AccentBtn}" Content="Open folder" Margin="0,0,8,0"/>
                        <Button x:Name="BtnCopyPath" Content="Copy path"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="HowTitle" Text="How to do it" Style="{StaticResource CardTitle}" FontSize="16"/>
                <ItemsControl x:Name="NextSteps">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PraBrand}" VerticalAlignment="Top"><TextBlock Text="{Binding N, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PraOnBrand}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Column="1" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="NextCmdBox" Margin="0,4,0,0">
                  <TextBlock Text="Or from the command line" Style="{StaticResource Label}"/>
                  <TextBox x:Name="NextCmd" Style="{StaticResource Mono}" MinHeight="40"/>
                  <Button x:Name="BtnCopyNextCmd" Content="Copy command" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Result of this run" Style="{StaticResource CardTitle}" FontSize="16"/>
                <TextBlock x:Name="ResultText" Style="{StaticResource Hint}" FontSize="13"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Batch status" Style="{StaticResource CardTitle}" FontSize="16"/>
              <TextBlock x:Name="BatchLine" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,14"/>
              <ItemsControl x:Name="Timeline" ItemTemplate="{StaticResource TimelineT}"/>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Action bar -->
    <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BtnBack" Content="Back"/>
        <TextBlock x:Name="Footer" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="BtnPreview" Content="Preview" Margin="0,0,8,0" MinWidth="110" Visibility="Collapsed"/>
          <Button x:Name="BtnNext" Style="{StaticResource AccentBtn}" MinWidth="200" Padding="18,7"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>