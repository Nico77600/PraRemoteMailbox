# Signed and hashed package files are byte-exact: no end-of-line conversion, so the Authenticode signature and the manifest SHA256 stay valid.
# Do not add a global autocrlf rule for these paths.
package/docs/** linguist-documentation

# Owner-signed files (eight PowerShell files and the manifest); cr-at-eol because their working-tree line endings are CRLF.
